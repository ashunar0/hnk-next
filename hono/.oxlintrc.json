{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "jsPlugins": ["hnk/lint"],
  "rules": {
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["api/**/*.ts"],
      "rules": {
        "hnk/layer-imports": "error",
        "hnk/no-foreign-table-reads": "error",
        "hnk/no-clock-outside-inbound": "error",
        "hnk/route-lists-are-paged": "error",
        "hnk/route-replies-through-reply": "error",
        "hnk/route-declares-auth": "error",
        "hnk/no-module-scope-state": "error",
        "hnk/no-id-cast": "error"
      }
    }
  ]
}
